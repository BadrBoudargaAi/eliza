{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",    "module": "NodeNext",
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowJs": true,
    "declaration": true,
    "types": ["node"]
  },
  "include": ["src/**/*"]
}
